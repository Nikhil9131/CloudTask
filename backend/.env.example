# =============================================================================
# CloudTask Backend Environment Configuration (.env.example)
# =============================================================================
# Used when running the local backend development server (npm run local).
# In AWS Lambda, these are automatically configured via template.yaml parameters.

# AWS Region (ap-south-1 Mumbai)
AWS_REGION=ap-south-1

# Amazon DynamoDB Table Name
TASKS_TABLE=CloudTaskTasks

# Amazon S3 Private Attachments Bucket Name
# When deploying to AWS via SAM, this is automatically generated as cloudtask-attachments-<AccountId>-<Region>
ATTACHMENTS_BUCKET=cloudtask-attachments-demo-ap-south-1

# Allowed CORS Origin for HTTP API Gateway
# Use '*' during development or specify the deployed frontend domain (e.g. https://main.dXXXXXXXXX.amplifyapp.com)
ALLOWED_ORIGIN=*

# Port for local development server (npm run local)
PORT=5000
