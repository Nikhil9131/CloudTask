# =============================================================================
# CloudTask Frontend Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env.local for local frontend development.
# In AWS Amplify Hosting, configure these under App Settings -> Environment Variables.

# The public HTTPS endpoint URL of your deployed Amazon API Gateway HTTP API.
# Leave blank to run the frontend in offline/local preview mode.
# Example: https://abc123xyz.execute-api.ap-south-1.amazonaws.com
NEXT_PUBLIC_API_URL=https://your-api-gateway-id.execute-api.ap-south-1.amazonaws.com

# SECURITY NOTE:
# Only variables prefixed with NEXT_PUBLIC_ are exposed to browser JavaScript.
# NEVER put AWS access keys, secret keys, or private database credentials here.
